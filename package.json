{
  "name": "unblock-ai-shield",
  "version": "1.0.0",
  "description": "Unblock AI Shield • Autonomous Cyber-Defense, Perimeter Hardening & Turnkey Peace of Mind for Business Leaders",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./assets/css/styles.css --minify",
    "start": "npx serve .",
    "hunter": "node scripts/outbound/run_cron_hunter.mjs",
    "preflight": "node scripts/preflight_sanity_check.mjs",
    "test:scanner": "node --test tests/test_header_scanner.mjs",
    "test:hardening": "node --test tests/test_scanner_shield_hardening.mjs",
    "test:i18n": "node --test tests/test_i18n_integrity.mjs",
    "test": "node --test tests/test_header_scanner.mjs && node --test tests/test_scanner_shield_hardening.mjs && node --test tests/test_i18n_integrity.mjs"
  },
  "keywords": [
    "cybersecurity",
    "autonomous-agent",
    "peace-of-mind",
    "antigravity",
    "defense-shield",
    "strike",
    "wompi"
  ],
  "author": "Unblock AI & Destraba AI",
  "license": "MIT",
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@supabase/supabase-js": "^2.116.0",
    "cheerio": "^1.2.0",
    "deep-email-validator": "^0.1.27",
    "docx": "^9.7.1",
    "dotenv": "^18.0.2",
    "nanoid": "^6.0.1",
    "pdf-lib": "^1.17.1",
    "resend": "^6.28.1",
    "stripe": "^22.6.2",
    "validator": "^13.15.35",
    "zod": "^4.6.5"
  }
}
